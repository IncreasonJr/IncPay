# ==============================================================================
# IncPay Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env for local development.
# In production (Vercel), configure these variables in the Vercel Project Settings.
# ==============================================================================

# [REQUIRED] Backend API Base URL
# For local dev: http://localhost:8000
# For production: https://incpay-backend.onrender.com
VITE_API_URL=http://localhost:8000

# [REQUIRED] Supabase Project API URL (same project as backend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# [REQUIRED] Supabase Client Anon Key (safe for public browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
