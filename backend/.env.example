# ==============================================================================
# IncPay Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your specific credentials.
# In production (Render), configure these directly in the Render Dashboard.
# ==============================================================================

# [REQUIRED] Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# [REQUIRED] Supabase Service Role or Anon Key for database/auth operations
SUPABASE_KEY=your-supabase-anon-or-service-key

# [REQUIRED] Paystack Secret Key (Use sk_test_... in dev, sk_live_... in production)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key

# [REQUIRED] Paystack Public Key (Use pk_test_... in dev, pk_live_... in production)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# [REQUIRED] Frontend CORS Allowed Origins
# Supports multiple origins separated by commas (e.g. http://localhost:5173,https://incpay.vercel.app)
FRONTEND_URL=http://localhost:5173,https://incpay.vercel.app

# [REQUIRED] Base URL for public checkout links encoded in merchant QR codes
PAYMENT_PAGE_BASE_URL=https://incpay.vercel.app

# [REQUIRED] Application Environment: "development", "staging", or "production"
# In production, triggers Strict-Transport-Security headers and live key validation
ENVIRONMENT=development

# [OPTIONAL] Minimum allowed listed payment amount in Ghanaian Cedis (₵)
MIN_PAYMENT_AMOUNT=1.0

# [OPTIONAL] Maximum allowed listed payment amount in Ghanaian Cedis (₵) to prevent abuse
MAX_PAYMENT_AMOUNT=50000.0

# [OPTIONAL] Resend API Key for emailing customer receipt PDFs
RESEND_API_KEY=re_your_resend_api_key

# [OPTIONAL] Sender email address for PDF receipts (e.g., receipts@yourdomain.com or onboarding@resend.dev)
RESEND_FROM_EMAIL=onboarding@resend.dev

# [OPTIONAL] Secret key for signing customer digital coupons (falls back to PAYSTACK_SECRET_KEY)
COUPON_SIGNING_SECRET=your_coupon_hmac_secret_key_here

